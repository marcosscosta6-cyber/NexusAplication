
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum StatusConexao {
  PENDENTE
  ACEITA
  RECUSADA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(120)
  usuario      String?  @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(191)
  senha        String   @db.VarChar(255)

  dataNasc     DateTime?
  situacao     String   @default("PENDENTE") @db.VarChar(20)
  escolaridade String?  @db.VarChar(100)
  comprovante  String?  @db.VarChar(255)

  curso        String?  @db.VarChar(100)
  area         String?  @db.VarChar(100)
  funcao       String?  @db.VarChar(100)
  biografia    String?  @db.Text
  fotoPerfil   String?  @db.VarChar(255)

  dataCadastro DateTime @default(now())

  conexoesEnviadas   Conexao[] @relation("SolicitanteConexoes")
  conexoesRecebidas  Conexao[] @relation("DestinatarioConexoes")
}

model Conexao {
  id             Int           @id @default(autoincrement())
  solicitanteId  Int
  destinatarioId Int
  status         StatusConexao @default(PENDENTE)
  dataCriacao    DateTime      @default(now())
  dataAtualizacao DateTime     @updatedAt

  solicitante  Usuario @relation("SolicitanteConexoes", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("DestinatarioConexoes", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([solicitanteId, status])
  @@index([destinatarioId, status])
  @@map("conexoes")
}
